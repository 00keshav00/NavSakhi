# ==============================================================================
# NavSakhi — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, API keys, or production credentials to source control.
# ==============================================================================

# Application Settings
APP_NAME=NavSakhi
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=Development
API_PREFIX=/api/v1

# Security & Session Authentication
# In production, set a cryptographically secure random string (e.g., openssl rand -hex 32)
SECRET_KEY=your_secret_key_placeholder
JWT_SECRET_KEY=your_jwt_secret_placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Database Configuration (MongoDB)
# Provide your standard MongoDB connection URI when configuring external database persistence:
# Example: mongodb://localhost:27017 or mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=
DATABASE_NAME=navsakhi_db

# Frontend Connectivity & CORS
FRONTEND_URL=http://localhost:3000

# Next.js Frontend Configuration (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional Routing & Geocoding Endpoints
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=

# Optional Weather & LLM Services
# Weather operates on free Open-Meteo API without requiring an API key
WEATHER_API_KEY=
WEATHER_API_URL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=
